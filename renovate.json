{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>shaneplunkett/workflows"
  ],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "platformAutomerge": true,
  "separateMajorMinor": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 9am on sunday"
    ]
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images in Nix modules",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "image = \"(?<depName>[^:@\"]+)(?::(?<currentValue>[^@\"]+))?(?:@(?<currentDigest>sha256:[a-f0-9]+))?\";"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Flake inputs pinned to a GitHub tag",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "url = \"github:(?<depName>[^/\"]+/[^/\"]+)/(?<currentValue>v[^\"]+)\";"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "npm packages run with npx",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "npx --yes (?<depName>[a-z0-9@/-]+)@(?<currentValue>[^\\s\"]+)"
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Every update in one weekly PR, which merges itself once the check passes",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "schedule": [
        "before 9am on sunday"
      ],
      "automerge": true
    },
    {
      "description": "git-refs has no release dates, so minimumReleaseAge would hold every pinned flake input forever",
      "matchManagers": [
        "nix"
      ],
      "minimumReleaseAge": null
    }
  ]
}

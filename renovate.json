{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>shaneplunkett/workflows"
  ],
  "reviewers": [
    "metrokitten"
  ],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "platformAutomerge": true,
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images in Nix modules",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "image = \"(?<depName>[^:@\"]+)(?::(?<currentValue>[^@\"]+))?(?:@(?<currentDigest>sha256:[a-f0-9]+))?\";"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Flake inputs pinned to a GitHub tag",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "url = \"github:(?<depName>[^/\"]+/[^/\"]+)/(?<currentValue>v[^\"]+)\";"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "npm packages run with npx",
      "managerFilePatterns": [
        "/^flake\\.nix$/"
      ],
      "matchStrings": [
        "npx --yes (?<depName>[a-z0-9@/-]+)@(?<currentValue>[^\\s\"]+)"
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for the Terraform providers",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "Terraform providers"
    },
    {
      "description": "UniFi's provider on its own, since a bump can change the live network",
      "matchPackageNames": [
        "ubiquiti-community/unifi"
      ],
      "groupName": "UniFi provider"
    },
    {
      "description": "One PR for the arr stack's container images",
      "matchFileNames": [
        "modules/services/arr/**"
      ],
      "groupName": "arr containers"
    },
    {
      "description": "One PR for openGym's api and web images",
      "matchPackageNames": [
        "ghcr.io/duartesantos8/opengym-*"
      ],
      "groupName": "openGym"
    },
    {
      "description": "One PR for the tools pinned in flake.nix",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "flake.nix"
      ],
      "groupName": "flake tools"
    },
    {
      "description": "One PR for workflow actions, apart from the shared workflows' pins, which land on their own as soon as a release is tagged",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "workflow actions",
      "matchPackageNames": [
        "!shaneplunkett/workflows"
      ]
    },
    {
      "description": "One PR per pinned flake input, merged as soon as CI builds it. git-refs has no release dates, so minimumReleaseAge would hold every input forever.",
      "matchManagers": [
        "nix"
      ],
      "commitMessageTopic": "flake input {{depName}}",
      "schedule": [
        "at any time"
      ],
      "minimumReleaseAge": null,
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "The update workflow owns the inputs on the forge, which Renovate can't reach over SSH",
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "/^ssh://forgejo@forge//"
      ],
      "enabled": false
    },
    {
      "description": "One PR for the Homebrew taps",
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "/^homebrew-/"
      ],
      "groupName": "Homebrew taps"
    }
  ]
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/block-hook-bypass.sh\"",
            "statusMessage": "Checking the git hooks aren't skipped"
          },
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/block-raw-builds.sh\"",
            "statusMessage": "Checking builds go through scripts/quietly.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/format-on-edit.sh\"",
            "statusMessage": "Formatting and linting edited files",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/stop-check.sh\"",
            "statusMessage": "Running scripts/check.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}

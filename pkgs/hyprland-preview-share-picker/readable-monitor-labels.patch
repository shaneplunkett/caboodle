+    fn compact_output_gaps(&mut self) {
+        self.monitors.sort_by_key(|monitor| monitor.x);
+        if let Some(mut edge) = self.monitors.first().map(|monitor| monitor.x + monitor.width as i32) {
+            self.monitors.iter_mut().skip(1).for_each(|monitor| {
+                if monitor.x > edge {
+                    monitor.x = edge;
+                }
+                edge = edge.max(monitor.x + monitor.width as i32);
+            });
+        }
+
+        self.monitors.sort_by_key(|monitor| monitor.y);
+        if let Some(mut edge) = self.monitors.first().map(|monitor| monitor.y + monitor.height as i32) {
+            self.monitors.iter_mut().skip(1).for_each(|monitor| {
+                if monitor.y > edge {
+                    monitor.y = edge;
+                }
+                edge = edge.max(monitor.y + monitor.height as i32);
+            });
+        }
+    }

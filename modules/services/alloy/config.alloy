loki.source.journal "journal" {
	forward_to    = [loki.process.noise.receiver]
	relabel_rules = loki.relabel.journal.rules
	labels        = {host = sys.env("ALLOY_HOST")}
}

loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["unit"]
		regex         = "sshd@.+\\.service"
		target_label  = "unit"
		replacement   = "sshd@.service"
	}

	rule {
		source_labels = ["unit"]
		regex         = "session-.+\\.scope"
		target_label  = "unit"
		replacement   = "session.scope"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.process "noise" {
	forward_to = [loki.write.monitoring.receiver]

	stage.match {
		selector = "{unit=\"podman-homeassistant.service\"}"

		stage.decolorize { }

		stage.multiline {
			firstline     = `^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d`
			max_wait_time = "3s"
			max_lines     = 1000
		}

		stage.regex {
			expression = `^\S+ \S+ (?P<ha_level>DEBUG|INFO|WARNING|ERROR|CRITICAL) `
		}

		stage.template {
			source   = "ha_level"
			template = `{{ if eq .Value "CRITICAL" }}crit{{ else }}{{ ToLower .Value }}{{ end }}`
		}

		stage.labels {
			values = {level = "ha_level"}
		}

		stage.match {
			selector = `{unit="podman-homeassistant.service"} |~ "^\\S+ \\S+ \\+\\d{4} UTC m=\\+"`

			stage.static_labels {
				values = {level = "info"}
			}
		}
	}

	stage.match {
		selector            = "{level=\"debug\"}"
		action              = "drop"
		drop_counter_reason = "debug"
	}

	stage.drop {
		expression          = "^Ignoring duplicate name '.+' in service file"
		drop_counter_reason = "dbus_duplicate_name"
	}
}

loki.write "monitoring" {
	endpoint {
		url = sys.env("LOKI_URL")
	}
}
